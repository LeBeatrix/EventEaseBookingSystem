@model IEnumerable<EventEaseBookingSystem.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1 class="mb-4">Booking Management</h1>

<!-- SEARCH -->
<form method="get" asp-action="Index" class="mb-4">

    <div class="row">

        <div class="col-md-6">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Search by Booking ID or Event Name..." />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100">
                Search
            </button>
        </div>

        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success">
                Create New Booking
            </a>
        </div>

    </div>

</form>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100 booking-card">

                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        Booking #@item.BookingId
                    </h5>
                </div>

                <div class="card-body">

                    <h4 class="text-primary">
                        @item.Event?.EventName
                    </h4>

                    <p>
                        <strong>Event Description:</strong><br />
                        @item.Event?.Description
                    </p>

                    <hr />

                    <p>
                        <strong>Venue:</strong>
                        @item.Venue?.VenueName
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @item.Venue?.Location
                    </p>

                    <p>
                        <strong>Booking Date:</strong>
                        @item.BookingDate.ToShortDateString()
                    </p>

                    <p>
                        <strong>Event Date:</strong>
                        @item.Event?.EventDate.ToShortDateString()
                    </p>

                </div>

                <div class="card-footer text-center bg-white border-0">

                    <a asp-action="Details"
                       asp-route-id="@item.BookingId"
                       class="btn btn-primary btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.BookingId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.BookingId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </div>

            </div>

        </div>
    }

</div>

<style>

    .booking-card {
        border-radius: 12px;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .booking-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

</style>