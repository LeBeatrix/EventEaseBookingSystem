@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4">Welcome to EventEase</h1>
    <p class="lead">Manage your events, venues, and bookings </p>

    <div class="mt-4">
        <a class="btn btn-primary btn-lg m-2" asp-controller="Events" asp-action="Index">
            View Events
        </a>

        <a class="btn btn-success btn-lg m-2" asp-controller="Venues" asp-action="Index">
            View Venues
        </a>

        <a class="btn btn-warning btn-lg m-2" asp-controller="Bookings" asp-action="Index">
            View Bookings
        </a>
    </div>
</div>
